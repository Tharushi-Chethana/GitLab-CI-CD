{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "LearnGitLabApp-TD-Prod",
    "containerDefinitions": [
        {
            "name": "learngitlabapp",
            "image": "903183826114.dkr.ecr.us-east-1.amazonaws.com/learngitlabapp",
            "portMappings": [{
                "name": "ngnix-80-tcp",
                "containerPort": 80,
                "hostPort": 80,
                "protocol": "tcp",
                "appProtocol": "http"
            }],
            "essential": true
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "512",
    "cpu": "256",
    "executionRoleArn": "arn:aws:iam::903183826114:role/ecsTaskExecutionRole"
}